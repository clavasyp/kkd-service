# Скопируйте в .env, если нужно поменять значения. Без .env работают эти же значения по умолчанию.
POSTGRES_DB=kkd
POSTGRES_USER=kkd
POSTGRES_PASSWORD=kkd_local_only
DB_PORT=15432
APP_PORT=8080

# Нужны только при запуске сервиса из IDE. В compose собираются из POSTGRES_*.
# DB_URL=jdbc:postgresql://localhost:15432/kkd
# DB_USER=kkd
# DB_PASSWORD=kkd_local_only
